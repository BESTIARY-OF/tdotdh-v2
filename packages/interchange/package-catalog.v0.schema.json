{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BESTIARY-OF/TDOTDH/packages/interchange/package-catalog.v0.schema.json",
  "title": "TDOTDH package catalog v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalog_id", "catalog_version", "compatibility", "packages"],
  "properties": {
    "schema": { "const": "tdotdh.package-catalog.v0" },
    "catalog_id": { "type": "string", "minLength": 1 },
    "catalog_version": { "const": 0 },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_baseline", "runtime", "required_contracts", "policy"],
      "properties": {
        "semantic_baseline": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "required_contracts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "policy": { "type": "string", "minLength": 1 }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "status", "capabilities", "requires", "provides"],
        "properties": {
          "id": { "type": "string", "pattern": "^(apps|packages)/[a-z0-9-]+$" },
          "kind": { "enum": ["app", "package"] },
          "status": { "enum": ["implemented", "contract-only", "planned"] },
          "capabilities": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "requires": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "provides": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      },
      "uniqueItems": true
    }
  }
}
